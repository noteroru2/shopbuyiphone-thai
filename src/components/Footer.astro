---
import { SITE } from '../config/site';
import CompanyRegisteredAddress from './CompanyRegisteredAddress.astro';
import PartnerSites from './PartnerSites.astro';
---

<footer class="border-t border-gold-border/30 bg-near-black text-off-white">
  <div class="mx-auto max-w-[1180px] px-4 py-14 sm:py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2">
          <img
            src={SITE.logo}
            alt=""
            width="36"
            height="36"
            class="inline-flex h-9 w-9 rounded-lg border border-gold-border bg-charcoal object-cover shadow-sm shadow-black/30"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
          <span class="text-base font-semibold text-off-white">ร้านรับซื้อไอโฟน.com</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted-light">
          ส่งรูป iPhone เพื่อ<strong class="font-semibold text-off-white">เช็คราคาได้ฟรี</strong>ผ่านไลน์ {SITE.lineHandle}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            class="inline-flex items-center justify-center rounded-xl bg-line-green px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-line-green-dark"
            href={SITE.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            แอดไลน์ @webuy ส่งรูปประเมินราคา
          </a>
          <a
            class="inline-flex items-center justify-center rounded-xl border border-gold-border bg-transparent px-4 py-2.5 text-sm font-semibold text-off-white transition hover:bg-glass-white"
            href={`tel:${SITE.telephone}`}
          >
            โทร {SITE.telephone}
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-8 lg:grid-cols-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-soft">บริการ</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/">รับซื้อไอโฟน</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟนมือสอง/">รับซื้อไอโฟนมือสอง</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อ-iphone/">รับซื้อ iPhone</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/เช็คราคาไอโฟน/">เช็คราคาไอโฟน</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/ตีราคาไอโฟน/">ตีราคาไอโฟน</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/ขายไอโฟน/">ขายไอโฟน</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-soft">รุ่น iPhone</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-17/">iPhone 17</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-16/">iPhone 16</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-15/">iPhone 15</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-14/">iPhone 14</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-13/">iPhone 13</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-12/">iPhone 12</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-11/">iPhone 11</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/iphone-se/">iPhone SE</a></li>
          </ul>
          <p class="mt-3 text-xs">
            <a class="font-medium text-gold-soft underline decoration-gold-border underline-offset-4 hover:text-off-white" href="/รับซื้อไอโฟน/">ดูรุ่นทั้งหมด</a>
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-soft">สภาพเครื่อง</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/จอแตก/">จอแตก</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/แบตเสื่อม/">แบตเสื่อม</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/เปิดไม่ติด/">เปิดไม่ติด</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/ติด-icloud/">ติด iCloud</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/ติดรหัส/">ติดรหัส</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/รับซื้อไอโฟน/face-id-เสีย/">Face ID เสีย</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-gold-soft">พื้นที่ / ติดต่อ</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="text-muted-light transition hover:text-off-white" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/คำถามที่พบบ่อย/">คำถามที่พบบ่อย</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/blog/">บทความ</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/ติดต่อเรา/">ติดต่อเรา</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/เกี่ยวกับเรา/">เกี่ยวกับเรา</a></li>
            <li><a class="text-muted-light transition hover:text-off-white" href="/เงื่อนไขการให้บริการ/">เงื่อนไขการให้บริการ</a></li>
            <li>
              <a
                class="text-muted-light transition hover:text-off-white"
                href={SITE.lineUrl}
                target="_blank"
                rel="noopener noreferrer">LINE {SITE.lineHandle}</a>
            </li>
            <li>
              <a class="text-muted-light transition hover:text-off-white" href={`tel:${SITE.telephone}`}>โทร {SITE.telephone}</a>
            </li>
            <li>
              <a
                class="text-muted-light transition hover:text-off-white"
                href={SITE.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer">Google Maps</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-gold-border/20 pt-10">
      <PartnerSites
        variant="footer"
        limit={5}
        description="บริการอื่นในเครือสำหรับผู้ที่ต้องการขายสินค้าไอทีประเภทอื่น เช่น แท็บเล็ต คอมพิวเตอร์พกพา กล้อง และอุปกรณ์มือสอง"
      />
      <p class="mt-4 text-sm text-muted-light">
        <a
          class="font-medium text-gold-soft underline decoration-gold-border underline-offset-4 hover:text-off-white"
          href="/เว็บไซต์ในเครือ/">เว็บไซต์ในเครือทั้งหมด</a>
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-gold-border/20 pt-8 text-xs text-gray-medium sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <CompanyRegisteredAddress variant="dark" />
        <p class="mt-3 text-xs text-gray-medium">© 2026 ร้านรับซื้อไอโฟน.com</p>
      </div>
      <div class="flex shrink-0 flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
        <a class="text-muted-light hover:text-off-white" href="/นโยบายความเป็นส่วนตัว/">นโยบายความเป็นส่วนตัว</a>
        <a class="text-muted-light hover:text-off-white" href="/เงื่อนไขการให้บริการ/">เงื่อนไขการให้บริการ</a>
      </div>
    </div>
  </div>
</footer>
