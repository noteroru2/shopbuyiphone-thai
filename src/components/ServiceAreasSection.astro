---
const locations = [
  { label: 'กรุงเทพ', href: '/รับซื้อไอโฟน/กรุงเทพ/' },
  { label: 'นนทบุรี', href: '/รับซื้อไอโฟน/นนทบุรี/' },
  { label: 'ปทุมธานี', href: '/รับซื้อไอโฟน/ปทุมธานี/' },
  { label: 'สมุทรปราการ', href: '/รับซื้อไอโฟน/สมุทรปราการ/' },
  { label: 'บางนา', href: '/รับซื้อไอโฟน/บางนา/' },
  { label: 'ลาดพร้าว', href: '/รับซื้อไอโฟน/ลาดพร้าว/' },
  { label: 'รังสิต', href: '/รับซื้อไอโฟน/รังสิต/' },
  { label: 'ภาคอีสาน', href: '/รับซื้อไอโฟน/ภาคอีสาน/' },
];
---

<section class="border-t border-gold-border/15 bg-section-warm py-16 sm:py-20" aria-labelledby="areas-heading">
  <div class="mx-auto w-full max-w-[1080px] px-4">
    <h2 id="areas-heading" class="border-l-4 border-gold pl-4 text-2xl font-bold tracking-tight text-text-dark">พื้นที่ให้บริการ</h2>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-muted">
    ให้บริการในกรุงเทพและปริมณฑล ทุกจังหวัดในภาคอีสาน และพื้นที่อื่นที่ระบุในหน้า{' '}
    <a class="font-medium text-gold-deep underline decoration-gold-border underline-offset-4 hover:text-gold" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a>
  </p>

  <ul class="mt-8 flex flex-wrap gap-2">
    {
      locations.map((l) => (
        <li>
          <a
            href={l.href}
            class="inline-flex rounded-full border border-gold-border/40 bg-white px-4 py-2 text-sm font-medium text-text-dark transition hover:border-gold-border hover:text-gold-deep"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>

    <p class="mt-6 text-sm text-text-muted">
      <a class="font-semibold text-gold-deep underline decoration-gold-border underline-offset-4 hover:text-gold" href="/พื้นที่ให้บริการ/">
        ดูพื้นที่และจังหวัดทั้งหมด
      </a>
    </p>
  </div>
</section>
