---
import type { FaqItem } from '../lib/seo';

interface Props {
  title?: string;
  lead?: string;
  faqs: FaqItem[];
}

const {
  title = 'คำถามที่พบบ่อย',
  lead = 'เกี่ยวกับการรับซื้อ iPhone มือสองและการประเมินราคา',
  faqs,
} = Astro.props;
---

<section class="border-t border-gold-border/10 bg-section-cream py-16 sm:py-20" aria-labelledby="faq-section-heading">
  <div class="mx-auto w-full max-w-[900px] px-4">
    <h2 id="faq-section-heading" class="border-l-2 border-gold pl-4 text-2xl font-bold tracking-tight text-text-dark">
      {title}
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-text-muted">{lead}</p>

    <div class="mt-10 divide-y divide-gold-border/15 rounded-2xl border border-gold-border/25 bg-white shadow-sm">
      {
        faqs.map((f, idx) => (
          <details class="group px-0 first:rounded-t-2xl last:rounded-b-2xl" open={idx === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-text-dark transition-colors hover:bg-gold-bg/35 sm:px-6 [&::-webkit-details-marker]:hidden">
              <span class="pr-2">{f.question}</span>
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold-border/50 text-lg font-light leading-none text-gold transition group-open:border-gold-border group-open:bg-gold-bg"
                aria-hidden="true"
              >
                <span class="block group-open:hidden">+</span>
                <span class="hidden group-open:block">−</span>
              </span>
            </summary>
            <div class="px-5 pb-5 pt-0 text-sm leading-relaxed text-text-muted sm:px-6">
              <div class="pt-3">{f.answer}</div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
