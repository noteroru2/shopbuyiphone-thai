---
const steps = [
  { title: 'ส่งรูป iPhone', desc: 'หลายมุม + รุ่น/ความจุ', tone: 'line' },
  { title: 'แจ้งรุ่น ความจุ และสภาพ', desc: 'เครื่องศูนย์ไทยหรือเครื่องนอก', tone: 'gold' },
  { title: 'รับราคาประเมินเบื้องต้น', desc: 'ตอบทาง LINE', tone: 'glass' },
  { title: 'นัดรับ/ส่งเครื่อง และรับเงิน', desc: 'ตามที่ตกลง', tone: 'line' },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-6">
  <div
    class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-charcoal via-dark-slate to-charcoal shadow-xl shadow-charcoal/20"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -left-16 -top-20 h-56 w-56 rounded-full bg-line-green/12 blur-3xl"></div>
      <div class="absolute -right-20 top-8 h-72 w-72 rounded-full bg-gold/10 blur-3xl"></div>
    </div>

    <div class="relative border-b border-gold/25 p-6 sm:p-8">
      <h2 class="text-base font-extrabold tracking-tight text-white sm:text-lg">ขายไอโฟนง่าย ๆ ใน 4 ขั้นตอน</h2>
      <p class="mt-1 text-sm text-white/70">ชัดเจน โปร่งใส ประเมินได้จากรูปเครื่อง</p>

      <ol class="mt-6 grid gap-3 sm:gap-4 lg:grid-cols-4">
        {steps.map((s, idx) => (
          <li
            class="relative rounded-3xl border border-white/10 bg-white/[0.05] p-5 shadow-sm backdrop-blur-sm transition-colors hover:border-gold/35"
          >
            <div class="flex items-start gap-3">
              <span
                class:list={[
                  'inline-flex h-10 w-10 flex-none items-center justify-center rounded-2xl text-sm font-extrabold ring-1',
                  s.tone === 'line' && 'bg-line-green text-white ring-white/10',
                  s.tone === 'gold' && 'bg-gold text-charcoal ring-gold-soft/40',
                  s.tone === 'glass' && 'bg-gold-bg/90 text-gold-deep ring-gold/30',
                ]}
                aria-hidden="true"
              >
                {String(idx + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <p class="text-sm font-bold text-white">{s.title}</p>
                <p class="mt-1 text-xs leading-relaxed text-white/65">{s.desc}</p>
              </div>
            </div>

            {idx < steps.length - 1 ? (
              <span
                aria-hidden="true"
                class="absolute right-[-14px] top-1/2 hidden h-px w-7 -translate-y-1/2 bg-gold/25 lg:block"
              />
            ) : null}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
