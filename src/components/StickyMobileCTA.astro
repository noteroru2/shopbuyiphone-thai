---
import { SITE } from '../config/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-gold-border/35 bg-charcoal/98 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-md sm:hidden"
  role="region"
  aria-label="แอดไลน์หรือโทรเช็คราคาไอโฟน"
>
  <p class="px-3 pt-2 text-center text-[10px] font-medium tracking-wide text-gold-soft/95">
    แอดไลน์ {SITE.lineHandle} เช็คราคาไอโฟน
  </p>
  <div class="mx-auto grid max-w-lg grid-cols-2 gap-2 px-3 pb-2 pt-1">
    <a
      class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-line-green px-2 text-[13px] font-bold leading-tight text-white shadow-sm transition hover:bg-line-green-dark sm:px-3 sm:text-sm"
      href={SITE.lineUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`แอดไลน์ ${SITE.lineHandle} ส่งรูปประเมินราคา`}
    >
      แอด {SITE.lineHandle}
    </a>
    <a
      class="inline-flex min-h-[44px] items-center justify-center rounded-xl border border-gold-border/80 bg-transparent px-3 text-sm font-bold text-gold-soft transition hover:bg-glass-white"
      href={`tel:${SITE.telephone}`}
      aria-label={`โทร ${SITE.telephone}`}
    >
      โทร
    </a>
  </div>
</div>
