---
import type { FaqItem } from '../lib/seo';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="border-t border-gold-border/10 bg-section-warm py-14 sm:py-16" aria-labelledby="aeo-quick-heading">
  <div class="mx-auto max-w-[1080px] px-4">
    <h2 id="aeo-quick-heading" class="border-l-2 border-gold pl-4 text-xl font-bold tracking-tight text-text-dark sm:text-2xl">
      คำตอบสั้น ๆ เรื่องรับซื้อไอโฟน
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-text-muted">
      สรุปสำหรับค้นหาและผู้ที่ต้องการข้อมูลเร็ว — รายละเอียดเพิ่มด้านล่างใน FAQ
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <article class="flex h-full flex-col rounded-2xl border border-gold-border/25 bg-white p-5 shadow-sm">
            <h3 class="text-sm font-bold leading-snug text-text-dark">{item.question}</h3>
            <p class="mt-3 flex-1 text-xs leading-relaxed text-text-muted sm:text-sm">{item.answer}</p>
            <div class="mt-4 h-px w-10 bg-gradient-to-r from-gold-border/70 to-transparent" aria-hidden="true" />
          </article>
        ))
      }
    </div>
  </div>
</section>
