---
import { SITE } from '../lib/seo';

const items = [
  {
    title: 'หน้าจอ About',
    desc: 'แสดงรุ่น ความจุ และซอฟต์แวร์ (ถ้าเข้าเมนูได้)',
    tone: 'blue',
    img: '/images/iphone-check-price.svg',
    alt: 'ตัวอย่างรูปหน้าจอ iPhone หน้า About เพื่อประเมินราคา',
  },
  {
    title: 'ด้านข้างเครื่อง',
    desc: 'เห็นรอยคม บุบ หรือสภาพกรอบจอ',
    tone: 'slate',
    img: '/images/iphone-condition.svg',
    alt: 'ตัวอย่างรูปด้านข้าง iPhone เพื่อประเมินราคา',
  },
  {
    title: 'ฝาหลังและกล้อง',
    desc: 'เห็นรอยฝาหลัง แตก หรือเลนส์กล้อง',
    tone: 'silver',
    img: '/images/iphone-models.svg',
    alt: 'ตัวอย่างรูปฝาหลัง iPhone และกล้องเพื่อประเมินราคา',
  },
  {
    title: 'อุปกรณ์ที่มี',
    desc: 'สายชาร์จ หัวแปลง กล่อง หรืออุปกรณ์อื่นที่แถมมา',
    tone: 'deep',
    img: '/images/hero-iphone-buying.svg',
    alt: 'ตัวอย่างรูปอุปกรณ์ที่มีเมื่อขาย iPhone',
  },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-12">
  <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-xl font-bold text-text-dark">ถ่าย 4 รูปนี้เพื่อประเมินราคาแม่นขึ้น</h2>
        <p class="mt-2 text-sm text-text-muted">ใช้เวลาไม่นาน แต่ช่วยให้ประเมินได้เร็วและใกล้เคียงราคาจริงมากขึ้น</p>
      </div>
      <a class="text-sm font-semibold text-text-muted hover:text-text-dark" href={SITE.lineUrl} target="_blank" rel="noopener noreferrer">
        แอดไลน์ {SITE.lineHandle}
      </a>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((it, idx) => (
        <div
          class:list={[
            'relative rounded-3xl border p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-gold/40 hover:shadow-md',
            it.tone === 'blue' && 'border-gold-border/25 bg-gold-bg/80',
            it.tone === 'slate' && 'border-gold-border/25 bg-[#F8FAFC]',
            it.tone === 'silver' && 'border-gold-border/25 bg-[#F3F4F6]',
            it.tone === 'deep' && 'border-gold-border/25 bg-white',
          ]}
        >
          <span
            aria-hidden="true"
            class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-2xl border border-white/70 bg-white/70 text-xs font-extrabold text-text-dark shadow-sm backdrop-blur"
          >
            {String(idx + 1).padStart(2, '0')}
          </span>
          <img
            src={it.img}
            alt={it.alt}
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
            class="mt-2 aspect-[3/2] w-full rounded-2xl border border-gold-border/25 bg-white object-cover"
          />
          <p class="mt-2 text-base font-bold text-text-dark">{it.title}</p>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{it.desc}</p>
          <p class="mt-2 text-xs font-semibold text-text-muted">
            แนะนำ: ให้เห็นชัด ไม่เบลอ แสงพอ และถ่ายมุมตรง ๆ
          </p>
        </div>
      ))}
    </div>

    <div class="mt-7 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
      <p class="text-sm font-semibold text-text-muted">
        ถ่ายครบ 4 มุมแล้ว ส่งผ่าน LINE เพื่อประเมินราคา
      </p>
      <a
        class="inline-flex items-center justify-center rounded-2xl bg-[#06C755] px-5 py-3 text-sm font-extrabold text-white shadow-sm hover:brightness-95"
        href={SITE.lineUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="แอด LINE ส่งรูปประเมินราคา"
      >
        แอดไลน์ {SITE.lineHandle} ส่งรูปประเมินราคา
      </a>
    </div>
  </div>
</section>

