---
const items = [
  {
    srcLg: '/images/happy_customer_deal.png',
    srcSm: '/images/happy_customer_deal.png',
    alt: 'การประเมินราคาและธุรกรรมที่ชัดเจนโปร่งใส ร้านรับซื้อไอโฟน.com',
    title: 'ประเมินโปร่งใส',
    desc: 'ธุรกรรมชัดเจน อธิบายเหตุผลของราคาก่อนตกลง',
  },
  {
    srcLg: '/images/iphone_checking_real.png',
    srcSm: '/images/iphone_checking_real.png',
    alt: 'ช่างเทคนิคตรวจเช็คสภาพเครื่องและตรวจเช็คราคาไอโฟนอย่างมืออาชีพ',
    title: 'ตรวจสภาพตามจริง',
    desc: 'เช็คจอ แบต และตัวเครื่องโดยทีมช่างผู้ชำนาญการ',
  },
  {
    srcLg: '/images/real_storefront_ubon.png',
    srcSm: '/images/real_storefront_ubon.png',
    alt: 'หน้าร้านรับซื้อไอโฟนจริง อำนาจเจริญ อุบลราชธานี ร้านอำพล เทรดดิ้ง',
    title: 'มีหน้าร้านตรวจสอบได้',
    desc: 'ร้านอำพล เทรดดิ้ง ตั้งอยู่บนถนนชยางกูร อุบลราชธานี',
  },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-12">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-text-dark">ความน่าเชื่อถือที่มองเห็นได้</h2>
      <p class="mt-2 text-sm text-text-muted">ภาพประกอบบริการและขั้นตอนการรับซื้อ</p>
    </div>
    <a class="text-sm font-semibold text-text-muted hover:text-text-dark" href="/เกี่ยวกับเรา/">ดูข้อมูลร้าน</a>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {items.map((it) => (
      <figure class="rounded-2xl border border-gold-border/25 bg-white/90 p-3 shadow-sm">
        <picture>
          <source srcset={it.srcLg} media="(min-width: 768px)" />
          <img
            src={it.srcSm}
            alt={it.alt}
            loading="lazy"
            decoding="async"
            width="640"
            height="640"
            class="aspect-square w-full rounded-xl object-cover"
          />
        </picture>
        <figcaption class="mt-3 px-1">
          <p class="text-sm font-semibold text-text-dark">{it.title}</p>
          <p class="mt-1 text-sm text-text-muted">{it.desc}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
