---
const sitelinkCandidates = [
  { href: '/รับซื้อไอโฟน/', label: 'รับซื้อไอโฟน' },
  { href: '/เช็คราคาไอโฟน/', label: 'เช็คราคาไอโฟน' },
  { href: '/ขายไอโฟน/', label: 'ขายไอโฟนมือสอง' },
  { href: '/รับซื้อไอโฟน/จอแตก/', label: 'ไอโฟนจอแตก' },
  { href: '/รับซื้อไอโฟน/แบตเสื่อม/', label: 'ไอโฟนแบตเสื่อม' },
  { href: '/พื้นที่ให้บริการ/', label: 'พื้นที่ให้บริการ' },
];
---

<nav class="border-t border-gold-border/15 bg-section-warm py-8 sm:py-10" aria-label="บริการหลัก">
  <div class="mx-auto max-w-[1080px] px-4">
    <div class="flex flex-wrap items-center justify-center gap-2 rounded-2xl border border-gold-border/30 bg-white px-4 py-5 text-sm shadow-sm sm:justify-start">
      {sitelinkCandidates.map((item) => (
        <a
          class="rounded-full border border-gold-border/30 bg-section-warm px-4 py-2 font-semibold text-text-dark transition-colors hover:border-gold/40 hover:bg-gold-bg hover:text-gold-deep"
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
