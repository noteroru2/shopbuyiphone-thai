---
import { SITE } from '../config/site';

const links = [
  { label: 'รับซื้อไอโฟน กรุงเทพ', href: '/รับซื้อไอโฟน/กรุงเทพ/' },
  { label: 'รับซื้อไอโฟน ปริมณฑล', href: '/รับซื้อไอโฟน/ปริมณฑล/' },
  { label: 'รับซื้อไอโฟน ภาคอีสาน', href: '/รับซื้อไอโฟน/ภาคอีสาน/' },
  { label: 'อุบลราชธานี', href: '/รับซื้อไอโฟน/อุบลราชธานี/' },
  { label: 'ขอนแก่น', href: '/รับซื้อไอโฟน/ขอนแก่น/' },
  { label: 'อุดรธานี', href: '/รับซื้อไอโฟน/อุดรธานี/' },
  { label: 'นครราชสีมา', href: '/รับซื้อไอโฟน/นครราชสีมา/' },
];
---

<section class="border-t border-gold-border/20 bg-section-cream py-14 sm:py-16" aria-labelledby="geo-home-heading">
  <div class="mx-auto max-w-[1180px] px-4">
    <div class="rounded-3xl border border-gold-border/30 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
      <h2 id="geo-home-heading" class="text-xl font-bold tracking-tight text-text-dark sm:text-2xl">
        รับซื้อไอโฟน กรุงเทพ ปริมณฑล และภาคอีสาน
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-text-muted">
        ร้านรับซื้อไอโฟน.com รองรับการส่งรูปประเมินราคาผ่านไลน์ {SITE.lineHandle} สำหรับลูกค้าในกรุงเทพ ปริมณฑล ภาคอีสาน และพื้นที่ให้บริการอื่น ๆ
        ลูกค้าสามารถส่งรูปเครื่อง รุ่น ความจุ Battery Health และสภาพเบื้องต้น เพื่อ<strong class="text-text-dark">เช็คราคาไอโฟน</strong>ก่อนนัดรับหรือจัดส่งเครื่อง
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="inline-flex rounded-full border border-gold-border/45 bg-section-warm px-4 py-2 text-sm font-medium text-text-dark transition hover:border-gold-border hover:text-gold-deep"
            >
              {l.label}
            </a>
          ))
        }
        <a
          href="/พื้นที่ให้บริการ/"
          class="inline-flex rounded-full border border-gold-border/70 bg-charcoal px-4 py-2 text-sm font-semibold text-off-white transition hover:bg-graphite"
        >
          พื้นที่ให้บริการทั้งหมด
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-gold-border/15 pt-8">
        <a
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-line-green px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-line-green-dark"
          href={SITE.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          แอดไลน์ {SITE.lineHandle} ส่งรูปประเมินราคา
        </a>
        <a
          class="text-sm font-semibold text-gold-deep underline decoration-gold-border underline-offset-4 hover:text-gold"
          href={`tel:${SITE.telephone}`}
        >
          โทร {SITE.telephone}
        </a>
      </div>
    </div>
  </div>
</section>
