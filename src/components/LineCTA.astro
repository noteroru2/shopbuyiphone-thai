---
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  variant?: 'dark' | 'compact' | 'inline';
  showPhone?: boolean;
  checklist?: string[];
}

const {
  title = `แอดไลน์ ${SITE.lineHandle} ส่งรูปประเมินราคา`,
  description = `ส่งรูป iPhone 3–5 รูป พร้อมรุ่น ความจุ Battery Health และสภาพเบื้องต้น เพื่อให้ทีมงานช่วยประเมินราคาก่อนตัดสินใจขาย`,
  variant = 'dark',
  showPhone = true,
  checklist = [],
} = Astro.props;

const isInline = variant === 'inline';
const isCompact = variant === 'compact';
---

{
  isInline ? (
    <div class="flex flex-col gap-3 rounded-2xl border border-gold-border/25 bg-charcoal/90 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-off-white">{title}</p>
        <p class="mt-1 text-xs leading-relaxed text-muted-light">{description}</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <a
          class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-line-green px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-line-green-dark"
          href={SITE.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          แอดไลน์ {SITE.lineHandle} ส่งรูปประเมินราคา
        </a>
        {showPhone ? (
          <a
            class="inline-flex min-h-[44px] items-center justify-center rounded-xl border border-gold-border/60 px-4 py-2.5 text-sm font-semibold text-gold-soft transition hover:bg-glass-white"
            href={`tel:${SITE.telephone}`}
          >
            โทร {SITE.telephone}
          </a>
        ) : null}
      </div>
    </div>
  ) : (
    <section
      class:list={[
        'relative isolate overflow-hidden border border-gold-border/20',
        isCompact ? 'rounded-2xl' : 'rounded-3xl',
        'bg-gradient-to-br from-charcoal via-graphite to-near-black shadow-[0_0_40px_rgba(212,175,55,0.08)]',
        isCompact ? 'p-5 sm:p-6' : 'p-6 sm:p-8',
      ]}
      aria-label="ช่องทางติดต่อ LINE"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_0%,rgba(212,175,55,0.12),transparent_55%)]" />
      <div class="relative">
        <h2 class="text-lg font-bold tracking-tight text-off-white sm:text-xl">{title}</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-light sm:text-base">{description}</p>
        {checklist.length ? (
          <ul class="mt-4 grid gap-2 text-sm text-muted-light sm:grid-cols-2">
            {checklist.map((c) => (
              <li class="flex gap-2">
                <span class="text-gold-soft" aria-hidden="true">
                  ✓
                </span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        ) : null}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-line-green px-6 py-3 text-sm font-semibold text-white shadow-[0_6px_24px_rgba(6,199,85,0.25)] transition hover:bg-line-green-dark sm:px-8 sm:text-base"
            href={SITE.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            แอดไลน์ {SITE.lineHandle} ส่งรูปประเมินราคา
          </a>
          {showPhone ? (
            <a
              class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-gold-border/70 bg-transparent px-6 py-3 text-sm font-semibold text-gold-soft transition hover:bg-glass-white sm:px-8"
              href={`tel:${SITE.telephone}`}
            >
              โทร {SITE.telephone}
            </a>
          ) : null}
        </div>
      </div>
    </section>
  )
}
