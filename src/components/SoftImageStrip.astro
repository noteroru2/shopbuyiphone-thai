---
const items = [
  {
    src: '/images/hero-iphone-buying.svg',
    alt: 'บริการรับซื้อ iPhone มือสอง ส่งรูปประเมินราคา',
    caption: 'รับซื้อไอโฟนหลายรุ่น',
  },
  {
    src: '/images/iphone-check-price.svg',
    alt: 'เช็คราคาไอโฟนจากรูปและข้อมูลรุ่น',
    caption: 'เช็คราคาไอโฟนก่อนขาย',
  },
  {
    src: '/images/iphone-condition.svg',
    alt: 'ประเมินสภาพ iPhone ตามรูปจริง',
    caption: 'ยึดสภาพจริง',
  },
  {
    src: '/images/iphone-models.svg',
    alt: 'รุ่น iPhone ที่เปิดรับประเมิน',
    caption: 'ครอบคลุมหลายรุ่น',
  },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-10">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((it) => (
      <figure class="rounded-2xl border border-gold-border/25 bg-white/90 p-3 shadow-sm">
        <img
          src={it.src}
          alt={it.alt}
          loading="lazy"
          decoding="async"
          class="aspect-[5/3] w-full rounded-xl object-cover"
          width="600"
          height="360"
        />
        <figcaption class="mt-3 text-xs font-semibold text-text-muted">{it.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
