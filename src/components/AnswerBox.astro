---
/**
 * กล่องคำตอบสั้นสำหรับ AEO — ใช้ในหน้า service / condition / location
 */
interface Props {
  question: string;
  answer: string;
  ctaText?: string;
  ctaHref?: string;
}

const { question, answer, ctaText, ctaHref } = Astro.props;
---

<section class="mx-auto w-full max-w-[1180px] px-4 pt-8" aria-labelledby="aeo-answer-heading">
  <div class="rounded-2xl border border-gold-border/35 bg-dark-card p-6 shadow-md sm:p-8">
    <h2 id="aeo-answer-heading" class="text-lg font-bold tracking-tight text-gold-soft sm:text-xl">
      {question}
    </h2>
    <p class="mt-3 text-base leading-relaxed text-off-white/95">{answer}</p>
    {
      ctaText && ctaHref ? (
        <p class="mt-4">
          <a
            class="text-sm font-semibold text-gold-soft underline decoration-gold-border underline-offset-4 hover:text-off-white"
            href={ctaHref}
          >
            {ctaText}
          </a>
        </p>
      ) : null
    }
  </div>
</section>
