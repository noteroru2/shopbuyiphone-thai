---
import { SITE } from '../config/site';

interface Props {
  subtitle?: string;
}

const {
  subtitle = 'แจ้งรุ่น ความจุ และสภาพเครื่อง — ทีมงานตอบตามคิว',
} = Astro.props;
---

<section class="mx-auto w-full max-w-[1180px] px-4 py-14 sm:py-16">
  <div
    class="relative isolate overflow-hidden rounded-3xl border border-gold-border/35 bg-gradient-to-br from-charcoal via-graphite to-black shadow-[0_0_0_1px_rgba(212,175,55,0.06),0_0_60px_rgba(212,175,55,0.12),0_24px_64px_rgba(0,0,0,0.45)]"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -inset-px rounded-3xl bg-gradient-to-br from-gold-border/25 via-transparent to-transparent opacity-60"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-[min(50vw,360px)] w-[min(88vw,440px)] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.22)_0%,transparent_65%)]"
    >
    </div>
    <div class="h-px w-full bg-gradient-to-r from-transparent via-gold-border/35 to-transparent" aria-hidden="true"></div>
    <div class="relative grid gap-10 p-8 sm:p-11 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)] lg:items-center lg:gap-12">
      <div class="relative z-[1]">
        <h2 class="text-2xl font-bold tracking-tight text-off-white sm:text-3xl sm:leading-tight">
          <span class="block">พร้อมขายไอโฟนวันนี้?</span>
          <span class="mt-3 block text-lg font-semibold leading-snug text-gold-soft sm:text-xl">
            ส่งรูปเช็คราคาได้ฟรีผ่านไลน์ {SITE.lineHandle}
          </span>
        </h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-light">{subtitle}</p>
        <div class="mt-8">
          <slot />
        </div>
        <p class="mt-3 text-xs text-gray-medium">แนะนำส่งรูป 3–5 รูป</p>
      </div>

      <div class="relative z-[1] flex justify-center lg:justify-end">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-3 rounded-[2rem] bg-[radial-gradient(ellipse_at_50%_45%,rgba(212,175,55,0.16),transparent_62%)] blur-2xl"
        />
        <div class="relative p-[1px]">
          <div
            class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-gold-border/40 via-gold-border/10 to-transparent"
            aria-hidden="true"
          />
          <div
            class="relative w-full max-w-xl overflow-hidden rounded-2xl border border-gold-border/45 bg-dark-card p-2.5 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05),0_12px_48px_rgba(0,0,0,0.35)] sm:p-3 lg:max-w-none"
          >
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_70%_18%,rgba(212,175,55,0.14),transparent_50%)]"></div>
            <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl ring-1 ring-gold-border/20">
              <img
                src="/images/iphone-check-price.svg"
                alt="พร้อมขายไอโฟน ส่งรูปเช็คราคาฟรีผ่านไลน์ @webuy ร้านรับซื้อไอโฟน โทร 0642579353"
                width="1024"
                height="768"
                class="absolute inset-0 h-full w-full object-contain object-center drop-shadow-[0_8px_32px_rgba(0,0,0,0.4)]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="relative z-[1] mt-2.5 text-center text-xs text-muted-light">
              {SITE.lineHandle} · โทร {SITE.telephone}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
