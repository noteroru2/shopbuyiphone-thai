---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import SeoCTA from '../../components/SeoCTA.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { absoluteUrl, breadcrumbListSchema, faqPageSchema } from '../../lib/seo';
import { conditionFaqs, generalFaqs, iphoneAccountFaqs, locationFaqs, pricingFaqs } from '../../data/faqs';

const title = 'คำถามที่พบบ่อยเกี่ยวกับการรับซื้อไอโฟน | ร้านรับซื้อไอโฟน.com';
const description =
  'รวมคำถามเกี่ยวกับรับซื้อไอโฟน เช็คราคาไอโฟน ขายไอโฟนมือสอง รับซื้อไอโฟนเสีย ไม่มีที่ชาร์จ เปิดไม่ติด จอแตก และการล้างข้อมูลก่อนขาย';
const canonical = absoluteUrl('/คำถามที่พบบ่อย/');

const breadcrumbs = [
  { name: 'หน้าแรก', url: absoluteUrl('/') },
  { name: 'คำถามที่พบบ่อย', url: canonical },
];

const faqs = [...generalFaqs, ...pricingFaqs, ...conditionFaqs, ...iphoneAccountFaqs, ...locationFaqs].slice(0, 12);
const schemas = [breadcrumbListSchema(breadcrumbs), faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <div class="bg-section-warm text-text-dark pb-4">
  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-text-dark sm:text-4xl">คำถามที่พบบ่อยเกี่ยวกับการรับซื้อไอโฟน</h1>
    <p class="mt-4 text-base leading-relaxed text-text-muted">
      หน้านี้รวบรวมคำถามที่คนถามบ่อยเกี่ยวกับ <strong>รับซื้อไอโฟน</strong> และการประเมินราคา เพื่อให้ได้คำตอบแบบชัด ๆ ในที่เดียว
      เหมาะสำหรับการอ่านก่อนส่งรูปเช็คราคา หรือก่อนตัดสินใจขาย
    </p>
    <p class="mt-3 text-sm leading-relaxed text-text-muted">
      หมวดใน FAQ ด้านล่างครอบคลุม: รับซื้อไอโฟนทั่วไป · เช็คราคาและประเมินราคา · จอแตก แบตเสื่อม เปิดไม่ติด · Apple ID / iCloud / Find My · เครื่องศูนย์ไทยและเครื่องนอก · พื้นที่ให้บริการ · การติดต่อ LINE @webuy และโทร 0642579353
    </p>
  </section>

  <RelatedLinks
    title="ลิงก์ที่ช่วยเริ่มต้นได้ไว"
    links={[
      { label: 'รับซื้อไอโฟน (รวมบริการ)', href: '/รับซื้อไอโฟน/', description: 'หน้า hub สำหรับเลือกบริการ/ทางลัดตามเคส' },
      { label: 'เช็คราคาไอโฟน', href: '/เช็คราคาไอโฟน/', description: 'ส่งรูป + รุ่น/ความจุ เพื่อประเมินราคาเบื้องต้นฟรี' },
      { label: 'ขายไอโฟน', href: '/ขายไอโฟน/', description: 'เตรียมเครื่องให้ปลอดภัยและได้ราคาดีขึ้น' },
      { label: 'พื้นที่ให้บริการ', href: '/พื้นที่ให้บริการ/', description: 'ดูโซนที่ให้บริการและแนวทางนัดรับ/ส่งเครื่อง' },
      { label: 'บทความ', href: '/blog/', description: 'คู่มือรุ่น ส่งรูปประเมิน และล้างข้อมูลก่อนขาย' },
    ]}
  />

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">คำตอบสั้น (อ่านจบใน 30 วินาที)</h2>
      <ul class="mt-4 space-y-2 text-sm text-text-muted">
        <li class="flex gap-2"><span aria-hidden="true">•</span> <strong>เช็คราคาได้ฟรี</strong> โดยส่งรูป + รุ่น/ความจุ + สภาพ/อาการผ่าน LINE</li>
        <li class="flex gap-2"><span aria-hidden="true">•</span> <strong>เครื่องเสียยังขายได้</strong> ในหลายกรณี ราคาขึ้นกับรุ่น ความจุ อาการ และความเสี่ยงที่เกี่ยวข้อง</li>
        <li class="flex gap-2"><span aria-hidden="true">•</span> <strong>iPhone ต้องปลด Apple ID/Find My</strong> ก่อนส่งเครื่องเพื่อให้โอนความเป็นเจ้าของได้ถูกต้อง</li>
        <li class="flex gap-2"><span aria-hidden="true">•</span> <strong>ราคาสุดท้ายอิงสภาพจริง</strong> ถ้ารูปชัดและแจ้งอาการตรง ๆ จะประเมินได้ใกล้เคียงขึ้น</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">คำถามยอดฮิต 10 ข้อ (ตอบแบบสั้นและตรง)</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">1) เช็คราคาไอโฟนฟรีไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ฟรีครับ ส่งรูป + รุ่น/ความจุ + สภาพ/อาการผ่าน LINE ได้เลย ไม่มีข้อผูกมัด
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">2) ไม่มีที่ชาร์จยังขายได้ไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ขายได้ครับ แค่แจ้งตรง ๆ เพื่อประเมินตามสภาพจริง ถ้ามีที่ชาร์จจะช่วยทดสอบได้ครบและคุยง่ายกว่า
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">3) เครื่องเปิดไม่ติดยังขายได้ไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            หลายกรณีขายได้ครับ แนะนำส่งวิดีโออาการ 5–10 วินาที และรูปที่ชาร์จ เพื่อประเมินใกล้เคียงขึ้น
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">4) จอแตกยังมีราคาไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ยังมีครับ ขึ้นกับรุ่น ความจุ และสภาพรวม แนะนำถ่ายรูปจอบนพื้นหลังขาว/ดำเพื่อเห็นตำหนิชัด
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">5) แบตเสื่อม/แบตบวมต้องแจ้งไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ควรแจ้งครับ เพราะมีผลต่อความปลอดภัยและการประเมินตามสภาพจริง
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">6) iPhone ต้องทำอะไรพิเศษ</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ก่อนส่งมอบจริงควรออก Apple ID และปิด Find My เพื่อไม่ให้ติด Activation Lock
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">7) เคยเปลี่ยนจอแท้/จอเทียม หรือเปลี่ยนแบตมาแล้ว มีผลไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            มีผลได้ครับ แนะนำแจ้งตามจริงและส่งรูปใกล้เคียงจุดที่ซ่อม จะช่วยให้ประเมินใกล้เคียงขึ้นและลดการถามซ้ำ
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">8) ประเมินจากรูปกับราคาจริงต่างกันไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            อาจต่างได้ถ้าสภาพจริงมีรอย/อาการที่ไม่เห็นในรูป แต่ถ้ารูปชัดและแจ้งอาการตรง ๆ จะใกล้เคียงขึ้นมาก
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">9) ต้องล้างข้อมูลก่อนเช็คราคาไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ไม่จำเป็นครับ เช็คราคาได้ก่อน แต่ก่อนส่งมอบจริงแนะนำล้างข้อมูลเพื่อความปลอดภัย
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4">
          <h3 class="text-base font-bold text-text-dark">10) อยู่ต่างจังหวัดทำยังไง</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ส่งรูปและโลเคชันมาก่อน เราช่วยแนะนำวิธีนัด/ส่งเครื่องที่เหมาะที่สุด ดูหน้า <a class="underline" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ก่อนส่งประเมินราคา: ส่งอะไรถึงจะ “คุยครั้งเดียวจบ”</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ถ้าคุณอยากได้คำตอบไวและลดการถามซ้ำ ให้ยึดหลัก “รูปชัด + รุ่นและความจุครบ + สภาพตรง” โดยเฉพาะรูปหน้าจอ About และรูปสายชาร์จ
      </p>
      <ul class="mt-4 list-disc pl-5 text-base leading-relaxed text-text-muted">
        <li>รูปหน้าจอ About (เห็นรุ่นและความจุ)</li>
        <li>รูปด้านข้างและฝาหลัง (เห็นรอยใช้งาน)</li>
        <li>รูปกล้องและขอบจอ</li>
        <li>รูปพอร์ตชาร์จและมุมกรอบเครื่อง</li>
        <li>รูปสายชาร์จ (ถ้ามี) และแจ้งถ้าไม่มี</li>
        <li>แจ้งเครื่องศูนย์ไทยหรือเครื่องนอก และสภาพ/อาการ เช่น แบตเสื่อม จอมีเส้น เปิดไม่ติด</li>
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        ถ้าไม่แน่ใจรุ่น ส่งรูป About มาได้เลย เราช่วยอ่านให้ และจะถามเพิ่มเฉพาะจุดที่จำเป็น
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">คำถามเรื่อง “เครื่องเสีย” ที่ถามบ่อย</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        คำว่า “เครื่องเสีย” มีหลายระดับ ตั้งแต่อาการเล็ก ๆ ไปจนถึงเปิดไม่ติดทั้งเครื่อง หลายกรณียังขายได้ แต่ต้องบอกอาการให้ชัด
        เพื่อให้ประเมินตามสภาพจริงได้ใกล้เคียงขึ้น
      </p>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">เปิดไม่ติด ต้องส่งอะไร</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ส่งวิดีโออาการ 5–10 วินาที ตอนกดเปิดเครื่อง + รูปที่ชาร์จ + รูปใต้เครื่อง จะช่วยให้ประเมินไวขึ้นมาก
          </p>
          <p class="mt-2 text-xs text-gray-medium">
            อ่านต่อ: <a class="underline" href="/รับซื้อไอโฟน/เปิดไม่ติด/">รับซื้อไอโฟนเปิดไม่ติด</a>
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">จอแตก/จอมีเส้น ต้องส่งอะไร</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ถ่ายรูปจอบนพื้นหลังขาวและดำ เพื่อเห็นตำหนิชัด และถ่ายขอบจอ มุมเครื่อง และกล้องเพิ่มเพื่อประเมินความเสี่ยงได้ดีขึ้น
          </p>
          <p class="mt-2 text-xs text-gray-medium">
            อ่านต่อ: <a class="underline" href="/blog/รับซื้อไอโฟนจอแตกแบตเสื่อม/">รับซื้อไอโฟนจอแตก แบตเสื่อม</a>
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">แบตเสื่อม/แบตบวม ต้องแจ้งไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ควรแจ้งครับ โดยเฉพาะแบตบวมเพราะเกี่ยวกับความปลอดภัย แจ้งอาการตามจริงและถ่ายรูปให้เห็นชัดจะช่วยมาก
          </p>
          <p class="mt-2 text-xs text-gray-medium">
            อ่านต่อ: <a class="underline" href="/blog/รับซื้อไอโฟนจอแตกแบตเสื่อม/">แบตเสื่อมและอาการอื่น ๆ</a>
          </p>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">ต้องซ่อมก่อนขายไหม</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">
            ไม่จำเป็นเสมอไปครับ ถ้าซ่อมไม่คุ้มหรือไม่แน่ใจ แนะนำขอประเมิน “ตามสภาพ” ก่อน แล้วค่อยตัดสินใจว่าจะซ่อมหรือขายเลย
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">คำถามเกี่ยวกับ Apple ID และการล็อกเครื่อง</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ก่อนส่งมอบ iPhone ควรออก Apple ID และปิด Find My ตามขั้นตอนของระบบ เพื่อไม่ให้ติด Activation Lock และทำให้โอนความเป็นเจ้าของได้ถูกต้อง
      </p>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        อ่านต่อแบบละเอียด: <a class="underline" href="/blog/ก่อนขายไอโฟนต้องล้างข้อมูลอย่างไร/">ก่อนขายไอโฟน ล้างข้อมูลและออกจากบัญชี</a>
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ใบเสร็จ ประกัน และกล่อง มีผลกับราคาไหม</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ในหลายเคส การมีกล่อง อุปกรณ์ครบ และใบเสร็จช่วยเพิ่มความมั่นใจในการถ่ายทอดสภาพและแหล่งที่มา แต่ไม่ได้การันตีว่าราคาจะสูงขึ้นเสมอไป เพราะราคามือสองยังขึ้นกับรุ่น ความจุ และสภาพหลักเป็นหลัก
        ถ้าคุณมีเอกสาร แนะนำถ่ายรูปประกอบและแจ้งระยะเวลาที่ใช้งานจริง จะช่วยให้การสนทนาราบรื่น
      </p>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        หากไม่มีใบเสร็จก็ยังขายได้ แค่ช่วยยืนยันรุ่นจากรูป About และรูปตัวเครื่องให้ชัด อ่านแนวทางเตรียมเครื่องเพิ่มเติมได้ที่หน้า <a class="underline" href="/วิธีขายไอโฟน/">วิธีขายไอโฟน</a> และ <a class="underline" href="/ขายไอโฟน/">ขายไอโฟน</a>
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
