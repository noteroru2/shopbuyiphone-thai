---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PriceFactors from '../components/PriceFactors.astro';
import FAQ from '../components/FAQ.astro';
import CTAButtons from '../components/CTAButtons.astro';
import AnswerBox from '../components/AnswerBox.astro';
import MoneyQuoteIphonePillar from '../components/pillars/money-quote-iphone-pillar.mdx';
import EeatTrustPanel from '../components/EeatTrustPanel.astro';
import { absoluteUrl } from '../lib/seo';

const title = 'ตีราคาไอโฟน ประเมินไว ตามสภาพจริง | ร้านรับซื้อไอโฟน.com';
const description =
  'ตีราคาไอโฟนก่อนขายแบบไม่ยัดเยียด ส่งรูป + รุ่น/ความจุ + สภาพ เราประเมินไวและอธิบายเหตุผลชัดเจน จ่ายเงินสดเมื่อรับเครื่อง';
const canonical = absoluteUrl('/ตีราคาไอโฟน/');

const breadcrumbs = [
  { name: 'หน้าแรก', url: absoluteUrl('/') },
  { name: 'ตีราคาไอโฟน', url: canonical },
];

const faqs = [
  {
    question: 'ตีราคาไอโฟนกับเช็คราคา ต่างกันอย่างไร',
    answer:
      'เช็คราคาเป็นการดูช่วงราคาจากข้อมูลเบื้องต้น ส่วนตีราคาจะละเอียดขึ้น โดยพิจารณารุ่น ความจุ สภาพ อาการ และอุปกรณ์ที่มี เพื่อให้ใกล้เคียงราคาซื้อขายจริงมากขึ้น',
  },
  {
    question: 'ตีราคาไอโฟนเสียได้ไหม',
    answer:
      'ได้ครับ ถ้าเครื่องมีอาการ เช่น เปิดไม่ติด จอแตก แบตเสื่อม หรือ Face ID/กล้องมีปัญหา แนะนำส่งรูป/วิดีโออาการและรุ่นเครื่องมาให้ครบ เพื่อประเมินใกล้เคียงขึ้น',
  },
  {
    question: 'ถ้าส่งรูปไม่ชัด ตีราคาได้ไหม',
    answer:
      'ได้ครับ แต่เพื่อให้แม่นยำ แนะนำถ่ายรูปหน้าจอที่เปิดติด ตัวเครื่องด้านบน/ล่าง พอร์ตชาร์จ และรอยตำหนิ (ถ้ามี) รวมถึงรูปหน้า About หรือหน้าข้อมูลระบบ',
  },
  {
    question: 'ขอประเมินหลายเครื่องพร้อมกันได้ไหม',
    answer:
      'ได้ครับ ส่งรูปและข้อมูลแยกเป็นเครื่อง ๆ จะช่วยให้ตอบไวและไม่สับสน โดยเฉพาะถ้ามีหลายรุ่นหรือหลายสภาพ',
  },
  {
    question: 'ประเมินฟรีไหม และไม่ขายได้ไหม',
    answer:
      'ฟรีครับ คุณสามารถขอตีราคาเพื่อใช้ตัดสินใจก่อนได้ ไม่มีข้อผูกมัด หากยังไม่พร้อมขายก็ได้เช่นกัน',
  },
  {
    question: 'ต้องเตรียมอะไรเพื่อให้ตีราคาแม่นขึ้น',
    answer:
      'แนะนำส่งรูป 3–5 รูป + รุ่นและความจุ + สภาพ/อาการ + อุปกรณ์ที่มี (สายชาร์จ/กล่อง) หากมีแคป Battery Health จะช่วยมาก',
  },
];
---

<ServiceLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
  serviceName="ตีราคาไอโฟน"
  faqs={faqs}
>
  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-text-dark sm:text-4xl">ตีราคาไอโฟน ประเมินไว ตามสภาพจริง</h1>
    <p class="mt-4 text-base leading-relaxed text-text-muted">
      ถ้าคุณอยากรู้ราคาที่ “ใกล้เคียงการซื้อขายจริง” การ <strong>ตีราคาไอโฟน</strong> จะช่วยได้มากกว่าการดูราคากลางแบบกว้าง ๆ.
      เราประเมินโดยดูทั้งรุ่น ความจุ สภาพภายนอก สุขภาพแบต หน้าจอ และอาการที่แจ้ง รวมถึงความครบของอุปกรณ์
      เพื่อให้คุณเข้าใจว่าราคาเกิดจากอะไรและตัดสินใจได้ง่าย
    </p>
    <p class="mt-4 text-base leading-relaxed text-text-muted">
      แนวทางของเราคือ “ตีราคาแบบอธิบายได้” ไม่เว่อร์และไม่กดราคา. ถ้าข้อมูลยังไม่พอ เราจะถามเพิ่มเฉพาะที่จำเป็น
      เช่น ภาพรอยตำหนิ ภาพสุขภาพแบต หรือภาพหน้า About. เมื่อคุณโอเคกับราคาประเมินแล้วจึงค่อยนัดรับเครื่อง/ส่งเครื่อง
      และจ่ายเงินทันทีเมื่อรับเครื่องตามตกลง
    </p>

    <AnswerBox
      question="ตีราคาไอโฟนต่างจากเช็คราคายังไง?"
      answer="ตีราคาจะดูรายละเอียดมากขึ้น เช่น รุ่น ความจุ สภาพ อาการ และอุปกรณ์ เพื่อให้กรอบราคาใกล้เคียงการซื้อขายจริงมากขึ้น — ส่งรูปและข้อมูลผ่านไลน์ @webuy เพื่อประเมินเบื้องต้นก่อนตัดสินใจ"
      ctaText="ไปหน้าเช็คราคาไอโฟน"
      ctaHref="/เช็คราคาไอโฟน/"
    />

    <div class="mt-6 rounded-3xl border border-gold-border/25 bg-section-warm p-6">
      <h2 class="text-lg font-bold text-text-dark">พร้อมตีราคา? ส่งรูปได้เลย</h2>
      <p class="mt-2 text-sm text-text-muted">
        ถ้าต้องการเช็คราคาแบบเร็ว ๆ อาจเริ่มที่หน้า <a class="underline" href="/เช็คราคาไอโฟน/">เช็คราคาไอโฟน</a> ก่อนก็ได้
      </p>
      <div class="mt-4">
        <CTAButtons />
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">คำตอบสั้น (AEO): ตีราคาไอโฟนคืออะไร</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        “ตีราคาไอโฟน” คือการประเมินแบบละเอียดขึ้นจากข้อมูลจริงของเครื่อง โดยดูรุ่น ความจุ สภาพ อาการ และอุปกรณ์ที่มี เพื่อให้ใกล้เคียงราคาซื้อขายจริงในตลาดมือสอง
        มากกว่าการเดาราคากลางกว้าง ๆ
      </p>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ถ้าคุณอยากตีราคาให้ไว ให้ส่งรูปเครื่องชัด ๆ 3–5 รูป + รุ่นและความจุ + สภาพ/อาการ และรูปที่ชาร์จ ถ้าเครื่องมีอาการ เช่น เปิดไม่ติด จอแตก
        ให้ส่งวิดีโออาการสั้น ๆ เพิ่ม จะช่วยมาก
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6">
        <h2 class="text-lg font-bold text-text-dark">ตีราคา vs เช็คราคา</h2>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          ถ้าคุณต้องการรู้ช่วงราคาแบบเร็ว ให้เริ่มจาก “เช็คราคา” แต่ถ้าคุณอยากเข้าใจเหตุผลของราคาและประเมินตามสภาพจริงมากขึ้น ให้ใช้ “ตีราคา”
        </p>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          ดูหน้าเช็คแบบเร็ว: <a class="underline" href="/เช็คราคาไอโฟน/">เช็คราคาไอโฟน</a>
        </p>
      </div>
      <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm lg:col-span-2">
        <h2 class="text-lg font-bold text-text-dark">ข้อมูลที่ทำให้ตีราคาใกล้เคียงขึ้น (ส่งทีเดียวจบ)</h2>
        <ul class="mt-3 list-disc pl-5 text-sm leading-relaxed text-text-muted">
          <li><strong>รุ่นและความจุ</strong>: หรือรูปหน้า About / สติ๊กเกอร์รุ่นบนตัวเครื่อง</li>
          <li><strong>สภาพ</strong>: จอ กรอบเครื่อง พอร์ตชาร์จ และรอยตำหนิ</li>
          <li><strong>แบต</strong>: หมดไว ต้องเสียบตลอด หรือบวม (ควรแจ้ง)</li>
          <li><strong>อุปกรณ์</strong>: ที่ชาร์จ กล่อง ใบเสร็จ (ถ้ามี)</li>
          <li><strong>อาการเสีย</strong> (ถ้ามี): เปิดไม่ติด จอแตก จอฟ้า ค้าง ดับเอง</li>
        </ul>
        <p class="mt-3 text-sm leading-relaxed text-text-muted">
          ถ้ายังไม่แน่ใจรุ่น อ่านต่อ:
          <a class="underline" href="/blog/เช็คราคาไอโฟนก่อนขาย/">เช็คราคาไอโฟนก่อนขาย</a>
          และ <a class="underline" href="/blog/ส่งรูปประเมินราคาไอโฟนผ่านไลน์/">ส่งรูปประเมินราคาไอโฟนผ่าน LINE</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ตัวอย่างข้อความที่ใช้ “ตีราคา” ได้เลย</h2>
      <div class="mt-3 rounded-2xl border border-gold-border/25 bg-section-warm p-4 text-sm leading-relaxed text-text-dark">
        ขอช่วยตีราคาไอโฟนครับ
        <br />รุ่น ______ ความจุ ______ GB
        <br />เครื่องศูนย์ไทย / เครื่องนอก: ______
        <br />สภาพ: ______ (มีรอย/จอมีเส้นหรือแตก/แบตเสื่อม/ปกติ)
        <br />อุปกรณ์: มีสายชาร์จ/มีกล่อง (ถ้ามี)
        <br />อยู่โซน ______
      </div>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        ถ้าเครื่องมีอาการ เช่น เปิดไม่ติด หรือจอแตก แนะนำส่งวิดีโออาการ 5–10 วินาที เพื่อประเมินตามสภาพจริงได้ใกล้เคียงขึ้น
      </p>
      <div class="mt-5">
        <CTAButtons />
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ตีราคาให้ใกล้เคียงจริง: ส่งข้อมูลแบบไหนดี</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        การตีราคาจะใกล้เคียงขึ้นมาก ถ้าข้อมูล “ครบและชัด” ตั้งแต่ต้น โดยเฉพาะรูปสภาพจริงและรุ่น/ความจุปัจจุบัน
      </p>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">รูปที่ควรมี (อย่างน้อย 5 รูป)</h3>
          <ul class="mt-2 list-disc pl-5 text-sm leading-relaxed text-text-muted">
            <li>หน้าจอเปิดเห็น About (ถ้าเปิดได้)</li>
            <li>ด้านข้างและฝาหลัง</li>
            <li>รูปหน้า About หรือสติ๊กเกอร์รุ่น</li>
            <li>มุมเครื่องและพอร์ต</li>
            <li>ที่ชาร์จ</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-5">
          <h3 class="text-base font-bold text-text-dark">ข้อมูลที่ควรพิมพ์แนบ (สั้น ๆ ก็พอ)</h3>
          <ul class="mt-2 list-disc pl-5 text-sm leading-relaxed text-text-muted">
            <li>รุ่น ความจุ และเครื่องศูนย์ไทยหรือเครื่องนอก</li>
            <li>สภาพ: มีรอยไหม จอมีเส้นไหม แบตหมดไวไหม</li>
            <li>อุปกรณ์: มีที่ชาร์จไหม มีกล่องไหม</li>
            <li>พื้นที่: อยู่โซนไหน เพื่อแนะนำวิธีนัดรับ/ส่งเครื่อง</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ตีราคาเครื่องเสีย (เปิดไม่ติด/จอแตก/แบตเสื่อม) ทำได้ไหม</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ทำได้ครับ แต่ควรส่งรูป/วิดีโออาการประกอบเพื่อให้ประเมินใกล้เคียงขึ้น เช่น วิดีโอกดเปิดเครื่อง 5–10 วินาที หรือรูปจอบนพื้นหลังขาว/ดำ
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a class="rounded-2xl border border-gold-border/25 bg-section-warm px-4 py-3 text-sm font-semibold text-text-dark hover:bg-gold-bg hover:border-gold/40" href="/รับซื้อไอโฟน/เปิดไม่ติด/">เปิดไม่ติด</a>
        <a class="rounded-2xl border border-gold-border/25 bg-section-warm px-4 py-3 text-sm font-semibold text-text-dark hover:bg-gold-bg hover:border-gold/40" href="/blog/รับซื้อไอโฟนจอแตกแบตเสื่อม/">จอแตก / แบตเสื่อม</a>
        <a class="rounded-2xl border border-gold-border/25 bg-section-warm px-4 py-3 text-sm font-semibold text-text-dark hover:bg-gold-bg hover:border-gold/40" href="/รับซื้อไอโฟน/">ดูหมวดรับซื้อตามอาการ</a>
        <a class="rounded-2xl border border-gold-border/25 bg-section-warm px-4 py-3 text-sm font-semibold text-text-dark hover:bg-gold-bg hover:border-gold/40" href="/วิธีขายไอโฟน/">วิธีขายไอโฟน</a>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        ถ้าเป็น iPhone รุ่น Pro / Pro Max แนะนำส่งรูปกล้องทุกตัวและขอบจอให้ชัด จะช่วยให้ตีราคาได้ใกล้เคียงขึ้น
      </p>
      <div class="mt-5">
        <CTAButtons />
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">สรุปแบบเร็ว: อยากตีราคาให้ตรง ต้องทำอะไร</h2>
      <ul class="mt-3 list-disc pl-5 text-base leading-relaxed text-text-muted">
        <li>ส่งรูปสภาพจริงให้ชัด (โดยเฉพาะจอ มุมเครื่อง และที่ชาร์จ)</li>
        <li>ส่งรุ่นและความจุปัจจุบัน หรือส่งรูปหน้า About ให้ร้านอ่านให้</li>
        <li>แจ้งอาการตามจริง ถ้ามี (เปิดไม่ติด/จอแตก/แบตเสื่อม)</li>
        <li>ระบุพื้นที่เพื่อแนะนำวิธีนัดรับ/ส่งเครื่อง</li>
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        พร้อมเริ่มแล้ว แอดไลน์ <strong>@webuy</strong> ส่งข้อมูลได้เลย หรือโทร <strong>0642579353</strong>
      </p>
      <p class="mt-2 text-xs text-gray-medium">
        ถ้าคุณไม่แน่ใจว่าควรถ่ายรูปมุมไหน ให้เริ่มจากรูปหน้า About และรูปที่ชาร์จก่อน แล้วค่อยเติมรูปจอและมุมเครื่องตามที่สะดวก
      </p>
      <p class="mt-2 text-xs text-gray-medium">ส่งข้อมูลให้ครบตั้งแต่แรก จะช่วยให้ตีราคาใกล้เคียงขึ้นมาก</p>
      <p class="mt-2 text-xs text-gray-medium">เริ่มได้เลยครับ</p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-12">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
