---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import SeoCTA from '../../components/SeoCTA.astro';
import { SITE } from '../../config/site';
import { absoluteUrl, breadcrumbListSchema, faqPageSchema } from '../../lib/seo';
import { locationFaqs } from '../../data/faqs';
import { serviceAreaGroups } from '../../data/service-areas';

const title = 'พื้นที่ให้บริการรับซื้อไอโฟน | กรุงเทพ ปริมณฑล อีสาน ภูเก็ต หาดใหญ่';
const description =
  'ดูพื้นที่ให้บริการรับซื้อไอโฟน กรุงเทพและปริมณฑล ทุกจังหวัดในภาคอีสาน สระแก้ว จันทบุรี ตราด พัทลุง ภูเก็ต หาดใหญ่ และสงขลา';
const canonical = absoluteUrl('/พื้นที่ให้บริการ/');

const breadcrumbs = [
  { name: 'หน้าแรก', url: absoluteUrl('/') },
  { name: 'พื้นที่ให้บริการ', url: canonical },
];

const faqs = locationFaqs.slice(0, 6);
const schemas = [breadcrumbListSchema(breadcrumbs), faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <PageHero
    eyebrow="พื้นที่ให้บริการ"
    title="พื้นที่ให้บริการรับซื้อไอโฟน"
    description="ไม่ว่าคุณจะอยู่พื้นที่ไหน แนะนำเริ่มจากส่งรูปประเมินราคาผ่าน LINE @webuy ก่อน เพื่อเช็คราคาเบื้องต้นได้ไว แล้วค่อยเลือกวิธีรับเครื่องที่เหมาะกับพื้นที่ เช่น นัดรับในโซนที่สะดวก หรือส่งขนส่งตามที่ตกลงกัน"
    badges={['กรุงเทพและปริมณฑล', 'ภาคอีสาน', 'LINE @webuy']}
    tertiaryText="เช็คราคาไอโฟนก่อนขาย"
    tertiaryHref="/เช็คราคาไอโฟน/"
    primaryCtaHref={SITE.lineUrl}
    secondaryCtaHref={`tel:${SITE.telephone}`}
    microcopy="ส่งรูป iPhone 3–5 รูปผ่านไลน์ @webuy เพื่อประเมินราคาเบื้องต้น ไม่ต้องกรอกฟอร์ม"
    variant="dark"
  />

  <div class="bg-section-warm text-text-dark pb-16">
    <Breadcrumbs items={breadcrumbs} variant="light" />

    <section class="mx-auto w-full max-w-6xl px-4 pt-8">
      <p class="text-base leading-relaxed text-text-muted">
        พื้นที่โดยประมาณที่ครอบคลุมในเว็บไซต์นี้:{' '}
        <span class="font-semibold text-text-dark">{SITE.serviceAreaGroups.map((g) => g.group).join(' · ')}</span>
      </p>
    </section>

    <section class="mx-auto w-full max-w-6xl px-4 pt-8">
      <div class="rounded-2xl border border-gold-border/35 bg-charcoal p-6 shadow-md sm:p-8">
        <h2 class="text-lg font-bold tracking-tight text-gold-soft sm:text-xl">อยู่ต่างจังหวัดขายไอโฟนได้ไหม</h2>
        <p class="mt-3 text-base leading-relaxed text-off-white/95">
          ได้ครับ เริ่มจากส่งรูปเครื่อง รุ่น/ความจุ และสภาพผ่าน LINE เพื่อเช็คราคาเบื้องต้นก่อน จากนั้นทีมงานจะแนะนำวิธีที่เหมาะกับพื้นที่ของคุณ เช่น นัดเจอในโซนที่สะดวก หรือส่งเครื่องทางขนส่งตามขั้นตอนที่ตกลงกัน
        </p>
        <p class="mt-4 text-sm text-muted-light">
          พร้อมเริ่ม แอดไลน์ <strong class="text-gold-soft">{SITE.lineHandle}</strong> หรือโทร <strong class="text-off-white">{SITE.phone}</strong>
        </p>
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-4 pt-8">
      <h2 class="text-xl font-bold tracking-tight text-text-dark sm:text-2xl">กลุ่มพื้นที่ให้บริการ</h2>
      <div class="mt-5 grid gap-4 lg:grid-cols-2">
        {serviceAreaGroups.map((g) => (
          <div class="rounded-2xl border border-gold-border/40 bg-dark-card p-6 shadow-[0_0_0_1px_rgba(212,175,55,0.08)]">
            <h3 class="text-lg font-bold text-gold-soft">{g.group}</h3>
            <p class="mt-3 text-sm leading-relaxed text-off-white/90">
              {g.areas.join(' · ')}
            </p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-text-muted">
        หมายเหตุ: ถ้าพื้นที่ของคุณไม่ได้อยู่ในรายการด้านบน สามารถส่งโลเคชันมาได้ เราช่วยแนะนำทางเลือกที่เหมาะที่สุด
      </p>
    </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ต้องส่งอะไรเพื่อให้ประเมินไว (ใช้ได้ทุกพื้นที่)</h2>
      <ul class="mt-4 list-disc pl-5 text-base leading-relaxed text-text-muted">
        <li>รูป 3–5 รูป: หน้าจอ About, ด้านข้างและฝาหลัง, กล้อง, มุมที่มีรอย, สายชาร์จ</li>
        <li>ข้อมูลรุ่น: รุ่น ความจุ เครื่องศูนย์ไทยหรือเครื่องนอก (หรือส่งรูป About ให้ร้านอ่านให้)</li>
        <li>สภาพ/อาการ: ใช้งานปกติ / มีรอย / แบตเสื่อม / จอมีเส้น / เปิดไม่ติด</li>
        <li>โลเคชันหรือโซนคร่าว ๆ เพื่อแนะนำวิธีนัดรับ/ส่งเครื่องที่เหมาะที่สุด</li>
      </ul>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        ถ้าเครื่องมีอาการ แนะนำส่งวิดีโออาการ 5–10 วินาทีด้วย จะช่วยมาก
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">การส่งเครื่องทางขนส่ง (เช็กลิสต์สั้น ๆ)</h2>
      <ul class="mt-3 list-disc pl-5 text-base leading-relaxed text-text-muted">
        <li>ถ่ายวิดีโอสภาพเครื่องก่อนแพ็ก (เห็นจอและตัวเครื่อง)</li>
        <li>กันกระแทกมุมเครื่องและฝาจอเป็นพิเศษ</li>
        <li>แยกที่ชาร์จใส่ซองกันกระแทก ไม่ให้กดทับเครื่อง</li>
        <li>ใช้ขนส่งที่มี tracking และเก็บเลขพัสดุไว้</li>
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        ถ้าคุณต้องการให้เราแนะนำวิธีส่งที่เหมาะกับเคสของคุณ ส่งรูปและโลเคชันมาก่อน แล้วค่อยคุยขั้นตอนที่สบายใจได้
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-lg font-extrabold text-text-dark">ลิงก์พื้นที่ยอดนิยม (กรุงเทพ/ปริมณฑล)</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {[
          { label: 'กรุงเทพ', href: '/รับซื้อไอโฟน/กรุงเทพ/' },
          { label: 'นนทบุรี', href: '/รับซื้อไอโฟน/นนทบุรี/' },
          { label: 'ปทุมธานี', href: '/รับซื้อไอโฟน/ปทุมธานี/' },
          { label: 'สมุทรปราการ', href: '/รับซื้อไอโฟน/สมุทรปราการ/' },
          { label: 'บางนา', href: '/รับซื้อไอโฟน/บางนา/' },
          { label: 'ลาดพร้าว', href: '/รับซื้อไอโฟน/ลาดพร้าว/' },
          { label: 'รังสิต', href: '/รับซื้อไอโฟน/รังสิต/' },
          { label: 'พระราม 2', href: '/รับซื้อไอโฟน/พระราม2/' },
          { label: 'รามคำแหง', href: '/รับซื้อไอโฟน/รามคำแหง/' },
          { label: 'ห้วยขวาง', href: '/รับซื้อไอโฟน/ห้วยขวาง/' },
        ].map((l) => (
          <a
            href={l.href}
            class="rounded-full border border-gold-border/25 bg-white px-3 py-1.5 text-xs font-semibold text-text-dark shadow-sm hover:bg-gold-bg hover:border-gold/40"
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">นัดรับ/นัดเจอ vs ส่งขนส่ง (เลือกแบบไหนดี)</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        วิธีรับเครื่องที่เหมาะสมขึ้นกับพื้นที่และความสะดวกของคุณ โดยทั่วไปมี 2 แนวทางหลัก คือ “นัดรับ/นัดเจอ” และ “ส่งเครื่องทางขนส่ง”
        ทั้งสองแบบสามารถเริ่มจากการส่งรูปเพื่อเช็คราคาเบื้องต้นได้เหมือนกัน
      </p>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-gold-border/25 bg-section-warm p-5">
          <h3 class="text-base font-bold text-text-dark">นัดรับ/นัดเจอ</h3>
          <ul class="mt-2 list-disc pl-5 text-sm leading-relaxed text-text-muted">
            <li>เหมาะกับพื้นที่ที่เดินทางสะดวก หรือมีจุดนัดที่ชัดเจน</li>
            <li>ข้อดีคือคุยรายละเอียดหน้างานได้ง่ายและตรวจสภาพได้ทันที</li>
            <li>ควรเลือกจุดนัดที่ปลอดภัยและมีคนเยอะ</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-section-warm p-5">
          <h3 class="text-base font-bold text-text-dark">ส่งเครื่องทางขนส่ง</h3>
          <ul class="mt-2 list-disc pl-5 text-sm leading-relaxed text-text-muted">
            <li>เหมาะกับต่างจังหวัด หรือคนที่ไม่สะดวกนัดเจอ</li>
            <li>ข้อดีคือประหยัดเวลา แต่ต้องแพ็กให้แน่นและมีหลักฐาน</li>
            <li>ควรใช้ขนส่งที่มี tracking และเก็บเลขพัสดุไว้</li>
          </ul>
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        ถ้าคุณไม่แน่ใจว่าเคสของคุณเหมาะกับแบบไหน ให้ส่งรูป + โลเคชันมาได้ เราช่วยแนะนำทางเลือกที่เหมาะที่สุด
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">ตัวอย่างข้อความที่ส่งเพื่อระบุพื้นที่ (คัดลอกได้)</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4 text-sm leading-relaxed text-text-dark">
          ขอเช็คราคาไอโฟนครับ
          <br />อยู่โซน ______ (แนบโลเคชันได้)
          <br />รุ่น ______ (แนบรูปใต้เครื่อง)
          <br />รุ่น ______ ความจุ ______ GB
          <br />สภาพใช้งานปกติ มีที่ชาร์จ
        </div>
        <div class="rounded-2xl border border-gold-border/25 bg-white p-4 text-sm leading-relaxed text-text-dark">
          ขอประเมินiPhoneตามสภาพครับ
          <br />อยู่โซน ______ (แนบโลเคชันได้)
          <br />รุ่น ______ (แนบรูปใต้เครื่อง)
          <br />อาการ: ______ (เปิดไม่ติด/จอแตก/แบตเสื่อม)
          <br />มีที่ชาร์จครับ (แนบรูป)
        </div>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-text-muted">
        ถ้าคุณส่งรูปให้ครบและแจ้งพื้นที่ให้ชัด เราจะช่วยประเมินและแนะนำวิธีรับเครื่องที่เหมาะที่สุดได้ไวขึ้นมาก
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">กรุงเทพและปริมณฑล: เลือกจุดนัดอย่างไรให้ปลอดภัยและสะดวก</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        พื้นที่เมืองใหญ่มีตัวเลือกการเดินทางหลากหลาย แต่หลักการเดียวกันคือควรเลือกจุดนัดที่มีคนพลุกพล่าน เดินทางเข้าออกสะดวก และมีแสงสว่างเพียงพอถ้าต้องตรวจเครื่องหน้างาน ถ้าคุณอยู่โซนที่มีหลายเขตให้เลือก ให้พิมพ์โลเคชันคร่าว ๆ ในไลน์เพื่อให้เราช่วยหาจุดพบที่เหมาะสมได้เร็วขึ้น
      </p>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        การพกเครื่องในกระเป๋าที่มีซับฟองหรือปลอกป้องกันแรงกระแทกช่วยลดความเสี่ยงระหว่างเดินทาง และควรถ่ายรูปสภาพเครื่องก่อนออกจากบ้านเป็นหลักฐานเล็กน้อยที่เป็นประโยชน์ต่อทั้งสองฝ่ายหากเกิดเหตุไม่คาดคิดระหว่างทาง
      </p>
      <p class="mt-3 text-sm leading-relaxed text-text-muted">
        สำหรับคีย์เวิร์ดที่เกี่ยวข้องกับการประเมินเบื้องต้น แนะนำเริ่มจากหน้า <a class="underline" href="/เช็คราคาไอโฟน/">เช็คราคาไอโฟน</a> แล้วค่อยเลือกทางลัดพื้นที่จากปุ่มด้านบนของหน้านี้
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pt-10">
    <div class="rounded-3xl border border-gold-border/25 bg-section-warm p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-text-dark">รับซื้อไอโฟนภาคอีสาน</h2>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        ภาคอีสานมีหลายจังหวัดและระยะทางภายในจังหวัดที่แตกต่างกัน ดังนั้นการขายไอโฟนมือสองหรือการขอประเมินราคาเบื้องต้นจึงควรเริ่มจากการส่งรูปและข้อมูลรุ่นผ่านไลน์ {SITE.lineHandle} ก่อนเสมอ
        เพื่อให้ได้กรอบราคาและขั้นตอนที่ชัดเจนก่อนตัดสินใจเดินทางหรือส่งขนส่ง ไม่ว่าคุณจะอยู่เขตเมืองหรืออำเภอรอบนอก การแจ้งชื่ออำเภอคร่าว ๆ พร้อมรูปเครื่องจะช่วยให้คุยเรื่องแนวทางนัดพบในบริเวณตัวเมือง จุดขนส่ง หรือสถานที่สาธารณะได้เหมาะสมขึ้น
        โดยยังคงต้องสอบถามพื้นที่ให้บริการและเงื่อนไขการนัดหรือส่งเครื่องในแชท ไม่ควรสรุปล่วงหน้าว่ามีหน้าร้านหรือทีมรับถึงที่ในทุกจังหวัด
      </p>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        หากต้องการภาพรวมคีย์เวิร์ด <strong>รับซื้อไอโฟนภาคอีสาน</strong> อ่านหน้า{' '}
        <a class="font-semibold text-gold-deep underline decoration-gold-border underline-offset-4 hover:text-gold" href="/รับซื้อไอโฟน/ภาคอีสาน/">รับซื้อไอโฟนภาคอีสาน</a>
        {' '}        จากนั้นเลือกเข้าไปหน้าจังหวัดของคุณเพื่อดูรายชื่ออำเภอสำคัญและคำถามที่พบบ่อยเฉพาะพื้นที่
        ทุกหน้าเน้นการประเมินเบื้องต้นผ่านไลน์ {SITE.lineHandle} และการโทร {SITE.phone} เพื่อสอบถามขั้นตอนก่อนส่งมอบเครื่อง
      </p>
