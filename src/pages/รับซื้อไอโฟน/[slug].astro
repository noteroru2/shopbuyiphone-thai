export async function getStaticPaths() {
  const [models, conditions, locations] = await Promise.all([
    getCollection('models'),
    getCollection('conditions'),
    getCollection('locations'),
  ]);

  const all = [
    ...models.map((e) => ({ kind: 'model' as const, entry: e })),
    ...conditions.map((e) => ({ kind: 'condition' as const, entry: e })),
    ...locations.map((e) => ({ kind: 'location' as const, entry: e })),
  ];

  return all.map(({ kind, entry }) => ({
    params: { slug: entry.data.slug },
    props: { kind, entry },
  }));
}

const { kind, entry } = Astro.props as { kind: 'model' | 'condition' | 'location'; entry: any };
