---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { BreadcrumbItem, FaqItem } from '../lib/seo';
import { breadcrumbListSchema, faqPageSchema, serviceSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs: BreadcrumbItem[];
  serviceName: string;
  faqs?: FaqItem[];
  /** เช่น HowTo — ต่อท้าย breadcrumb/service/FAQ */
  extraSchemas?: Record<string, any>[];
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  breadcrumbs,
  serviceName,
  faqs = [],
  extraSchemas = [],
  ogType,
  articlePublishedTime,
  articleModifiedTime,
} = Astro.props;

const schemas = [
  breadcrumbListSchema(breadcrumbs),
  serviceSchema({ name: serviceName, url: canonical ?? breadcrumbs[breadcrumbs.length - 1]?.url ?? '', description }),
  ...(faqs.length ? [faqPageSchema(faqs)] : []),
  ...extraSchemas,
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  noindex={noindex}
  schemas={schemas}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
  articleModifiedTime={articleModifiedTime}
>
  <Breadcrumbs items={breadcrumbs} />
  <div class="bg-section-warm text-text-dark pb-16">
    <slot />
  </div>
</BaseLayout>

